# SCsub for building the Godot Cesium submodule
import os
import sys

Import("env")

# --- Detect build context: module (inside Godot source) vs extension (via our SConstruct.py) ---
# When running as a Godot module, the SCsub lives under modules/cesium_godot/
# and env will have been set up by Godot's SConstruct, not ours.
# When running as a GDExtension, our SConstruct.py calls us and has already
# imported CesiumBuildUtils and set up the env.

# Try importing CesiumBuildUtils. When running as a module inside the Godot
# source tree, it won't be on the default path — add our directory to sys.path.
_this_dir = os.path.dirname(File("SCsub").srcnode().abspath)
if _this_dir not in sys.path:
    sys.path.insert(0, _this_dir)

import CesiumBuildUtils as cesium_build_utils

# Detect if we're running as a module by checking whether compileTarget was
# explicitly passed. If not, and we can see env_modules exported by the
# Godot engine master SCsub, we're being invoked as a module.
_compile_target_arg = ARGUMENTS.get("compileTarget", "")
if _compile_target_arg == "module":
    _is_module = True
elif _compile_target_arg == "" or _compile_target_arg == "extension":
    # No explicit compileTarget — check if the Godot engine's module build
    # system is driving us. It resets env.modules_sources before each module.
    _is_module = hasattr(env, "modules_sources")
    if not _is_module:
        _is_module = os.sep + "modules" + os.sep in _this_dir
else:
    _is_module = False

if _is_module:
    cesium_build_utils.set_module_context()
    # In Godot 4.4, the master modules/SCsub exports env_modules (a clone of
    # env with the GODOT_MODULE define). Module SCsubs should clone that.
    Import("env_modules")
    cesium_env = env_modules.Clone()
else:
    cesium_env = env.Clone()

# Detect web platform from the SCons environment
is_web = env.get("platform", "") == cesium_build_utils.PLATFORM_WEB

# --- Add the correct preprocessor define for module vs extension ---
if _is_module:
    cesium_env.Append(CPPDEFINES=[cesium_build_utils.CESIUM_MODULE_DEF])
# (For extension builds, SConstruct.py already added CESIUM_GD_EXT)


def load_cesium_module(p_includePaths: list[str], moduleName: str, loadSources=False, rootDir=""):
    if (rootDir == ""):
        rootDir = cesium_build_utils.get_root_dir_native()
    base_include = "%s/%s/include" % (rootDir, moduleName)
    generated_include = "%s/%s/generated/include" % (rootDir, moduleName)
    p_includePaths.append(cesium_build_utils.scons_to_abs_path(base_include))
    p_includePaths.append(cesium_build_utils.scons_to_abs_path(generated_include))


