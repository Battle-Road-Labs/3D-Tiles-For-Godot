
[configuration]

entry_symbol = "test_cesium_init"

compatibility_minimum = 4.2

[libraries]
windows.debug.x86_64 = "res://addons/cesium_godot/lib/Godot3DTiles.windows.template_release.double.x86_64.dll"
windows.release.x86_64 = "res://addons/cesium_godot/lib/Godot3DTiles.windows.template_release.double.x86_64.dll"
linux.debug.x86_64 = "res://addons/cesium_godot/lib/libGodot3DTiles.linux.template_release.double.x86_64.so"
linux.release.x86_64 = "res://addons/cesium_godot/lib/libGodot3DTiles.linux.template_release.double.x86_64.so"
macos.debug.arm64 = "res://addons/cesium_godot/lib/libGodot3DTiles.macos.template_debug.double.arm64.dylib"
macos.release.arm64 = "res://addons/cesium_godot/lib/libGodot3DTiles.macos.template_release.double.arm64.dylib"
web.debug.wasm32 = "res://addons/cesium_godot/lib/Godot3DTiles.web.template_release.double.wasm32.wasm"
web.release.wasm32 = "res://addons/cesium_godot/lib/Godot3DTiles.web.template_release.double.wasm32.wasm"
web.debug.wasm64 = "res://addons/cesium_godot/lib/Godot3DTiles.web.template_release.double.wasm64.wasm"
web.release.wasm64 = "res://addons/cesium_godot/lib/Godot3DTiles.web.template_release.double.wasm64.wasm"


[icons]
CesiumGeoreference = "res://addons/cesium_godot/resources/icons/globe.svg"
Cesium3DTileset = "res://addons/cesium_godot/resources/icons/box.svg"
CesiumIonRasterOverlay = "res://addons/cesium_godot/resources/icons/image.svg"
CesiumDynamicCam = "res://addons/cesium_godot/resources/icons/video.svg"
CesiumOrbitCam = "res://addons/cesium_godot/resources/icons/orbit.svg"
